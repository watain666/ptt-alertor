REDIS_ENDPOINT=redis
REDIS_PORT=6379
DB_CONNECTION=http://dynamodb-local:8000
AWS_REGION=us-west-2

# Public base URL used by external callbacks (Telegram webhook, links in messages)
# Local only: http://localhost:9090
# Public tunnel/domain: https://ptt-alertor.your-domain.com
APP_HOST=http://localhost:9090

# WebSocket endpoint exposed to browser clients
# Local only: ws://localhost:9090/ws
# Public tunnel/domain: wss://ptt-alertor.your-domain.com/ws
APP_WS_HOST=ws://localhost:9090/ws

S3_DOMAIN=

AUTH_USER=admin
AUTH_PW=changeme
BOARD_HIGH=Gossiping,LoL

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Optional channels/services
MESSENGER_ACCESSTOKEN=
MESSENGER_VERIFYTOKEN=
MAILGUN_DOMAIN=
MAILGUN_APIKEY=
MAILGUN_PUBLIC_APIKEY=

# Cloudflare Tunnel token for exposing the app to the public internet
CLOUDFLARE_TUNNEL_TOKEN=